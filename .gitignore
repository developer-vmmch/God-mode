# ------------------------------------------------------------------------------
# OS and System Files
# ------------------------------------------------------------------------------
[Dd]esktop.ini
Thumbs.db
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db

# ------------------------------------------------------------------------------
# Unity Project Directories & Caches
# ------------------------------------------------------------------------------
/[Uu]nity[Pp]roject/[Ll]ibrary/
/[Uu]nity[Pp]roject/[Tt]emp/
/[Uu]nity[Pp]roject/[Oo]bj/
/[Uu]nity[Pp]roject/[Bb]uild/
/[Uu]nity[Pp]roject/[Bb]uilds/
/[Uu]nity[Pp]roject/[Ll]ogs/
/[Uu]nity[Pp]roject/[Uu]ser[Ss]ettings/
/[Uu]nity[Pp]roject/[Mm]emoryCaptures/
/[Uu]nity[Pp]roject/[Rr]ecordings/

# Root-level builds, logs, and artifacts
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Aa]rtifacts/
/[Tt]emp/

# Unity crash dumps and profiling data
sysinfo.txt
*.stackdump
Crashdump*
*.dmp

# Unity package manager cache
/[Uu]nity[Pp]roject/Packages/packages-lock.json.bak

# ------------------------------------------------------------------------------
# IDE and Editor Temporary Files
# ------------------------------------------------------------------------------
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# ------------------------------------------------------------------------------
# Blender Auto-Saves and Backups
# ------------------------------------------------------------------------------
*.blend1
*.blend2
*.blend@
*~

# ------------------------------------------------------------------------------
# Python Cache and Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# ------------------------------------------------------------------------------
# Compiled Binaries (Build outputs should not be committed to Git source)
# ------------------------------------------------------------------------------
*.apk
*.aab
*.exe
*.dll
!UnityProject/Assets/**/*.dll
*.so
*.dylib

# ------------------------------------------------------------------------------
# Preserved Directories Explicitly Tracked
# ------------------------------------------------------------------------------
!UnityProject/Assets/
!UnityProject/Packages/
!UnityProject/ProjectSettings/
!BlenderAssets/
!Tools/
!Docs/
